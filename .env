POSTGRES_USER=studio
POSTGRES_PASSWORD=studio
POSTGRES_DB=studio_riff
# 5434 car des PostgreSQL locaux occupent déjà 5432 et 5433 sur cette machine.
POSTGRES_PORT=5434

DATABASE_URL=postgres://studio:studio@localhost:5434/studio_riff
TEST_DATABASE_URL=postgres://studio:studio@localhost:5434/studio_riff_test

VALKEY_URL=redis://localhost:6379
SCHEDULE_CACHE_TTL_SECONDS=60

PORT=3000
