# Copier ce fichier en .env puis adapter les valeurs.
POSTGRES_USER=studio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=studio_riff
# Port exposé sur la machine hôte (changer si un PostgreSQL local occupe déjà 5432).
POSTGRES_PORT=5432

DATABASE_URL=postgres://studio:change-me@localhost:5432/studio_riff
# Base utilisée par les tests HTTP (vidée et re-seedée avant chaque test).
TEST_DATABASE_URL=postgres://studio:change-me@localhost:5432/studio_riff_test

# Laisser vide pour désactiver le cache.
VALKEY_URL=redis://localhost:6379
SCHEDULE_CACHE_TTL_SECONDS=60

PORT=3000
